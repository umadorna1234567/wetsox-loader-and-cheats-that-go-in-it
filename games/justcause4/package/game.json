{
  "formatVersion": 1,
  "id": "justcause4",
  "name": "Just Cause 4",
  "subtitle": "Solis",
  "backend": "justcause4",
  "module": "WetsoxJC4.dll",
  "artwork": "cover.jpg",
  "sections": [
    {
      "name": "Player",
      "icon": "player",
      "controls": [
        {
          "key": "god",
          "label": "Invulnerability",
          "defaultValue": false
        },
        {
          "key": "ammo",
          "label": "Unlimited ammo",
          "defaultValue": false
        },
        {
          "key": "vehicleBoost",
          "label": "Unlimited vehicle boost",
          "defaultValue": false
        }
      ]
    },
    {
      "name": "Wingsuit",
      "icon": "world",
      "controls": [
        {
          "key": "boost",
          "label": "Unlimited boost",
          "defaultValue": false
        },
        {
          "key": "rockets",
          "label": "Unlimited rockets",
          "defaultValue": false
        },
        {
          "key": "wingsuitSpeed",
          "label": "Flight speed",
          "type": "slider",
          "defaultValue": 1,
          "min": 0.5,
          "max": 100,
          "step": 0.1
        }
      ]
    },
    {
      "name": "Grapple",
      "icon": "aim",
      "controls": [
        {
          "key": "grappleRange",
          "label": "Unlimited grapple range",
          "defaultValue": false
        },
        {
          "key": "grappleSpeed",
          "label": "Grapple speed",
          "type": "slider",
          "defaultValue": 1,
          "min": 0.5,
          "max": 100,
          "step": 0.1
        }
      ]
    },
    {
      "name": "Hoverboard",
      "icon": "world",
      "controls": [
        {
          "key": "hoverboardSpeed",
          "label": "Hoverboard speed",
          "type": "slider",
          "defaultValue": 1,
          "min": 0.5,
          "max": 100,
          "step": 0.1
        }
      ]
    },
    {
      "name": "World",
      "icon": "world",
      "controls": [
        {
          "key": "speed",
          "label": "World speed",
          "type": "slider",
          "defaultValue": 1,
          "min": 0.25,
          "max": 3,
          "step": 0.05
        }
      ]
    },
    {
      "name": "Visuals",
      "icon": "eye",
      "controls": [
        {
          "key": "esp",
          "label": "Character ESP",
          "defaultValue": false
        },
        {
          "key": "enemiesOnly",
          "label": "Enemies only",
          "defaultValue": true
        },
        {
          "key": "tracers",
          "label": "Tracers",
          "defaultValue": false
        },
        {
          "key": "range",
          "label": "Detection range",
          "type": "slider",
          "defaultValue": 300,
          "min": 50,
          "max": 1000,
          "step": 1
        }
      ]
    },
    {
      "name": "Aimbot",
      "icon": "aim",
      "controls": [
        {
          "key": "aim",
          "label": "Aim assist (torso)",
          "defaultValue": false
        },
        {
          "key": "aimKey",
          "label": "Aim key",
          "type": "keybind",
          "defaultValue": "RMB"
        },
        {
          "key": "fov",
          "label": "Aim FOV diameter",
          "type": "slider",
          "defaultValue": 15,
          "min": 5,
          "max": 60,
          "step": 1
        },
        {
          "key": "smooth",
          "label": "Smoothing",
          "type": "slider",
          "defaultValue": 6,
          "min": 1,
          "max": 20,
          "step": 1
        }
      ]
    },
    {
      "name": "Teleport",
      "icon": "world",
      "controls": [
        {
          "key": "teleportWaypoint",
          "label": "Teleport to waypoint",
          "type": "action"
        },
        {
          "key": "waypointKey",
          "label": "Waypoint key",
          "type": "keybind",
          "defaultValue": ""
        },
        {
          "key": "teleportObjective",
          "label": "Teleport to objective",
          "type": "action"
        },
        {
          "key": "objectiveKey",
          "label": "Objective key",
          "type": "keybind",
          "defaultValue": ""
        }
      ]
    }
  ]
}
